{
  "name": "az-pos",
  "private": true,
  "version": "1.2.3",
  "description": "AZ POS — point de vente Algérie (web, Android, Windows)",
  "author": "AZ POS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && cross-env NATIVE=1 vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "license": "node tools/generate-license.mjs",
    "icons": "node scripts/make-icons.mjs",
    "tessdata": "node scripts/vendor-tessdata.mjs",
    "adb:vendor": "node scripts/vendor-adb.mjs",
    "off:pack": "python3 scripts/fetch-off-algeria.py --max-pages 1 --download-images --images-dir public/catalog/off --az-pos-out /tmp/off-az-pos-import.json --only-with-images",
    "native:deps": "npm install --no-save @capacitor/core@^7.4.3 @capacitor/cli@^7.4.3 @capacitor/android@^7.4.3 electron@^37.2.6 electron-builder@^26.0.12",
    "android:sync": "npm run build:native && npx cap sync android",
    "android:open": "npx cap open android",
    "desktop:dev": "npm run adb:vendor && npm run build:native && electron .",
    "desktop:build": "npm run adb:vendor && npm run build:native && electron-builder --win",
    "desktop:dir": "npm run adb:vendor && npm run build:native && electron-builder --win --dir",
    "desktop:build:all": "npm run adb:vendor && npm run build:native && electron-builder --win --linux --mac",
    "desktop:linux": "npm run adb:vendor && npm run build:native && electron-builder --linux",
    "desktop:mac": "npm run adb:vendor && npm run build:native && electron-builder --mac"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^4.10.38",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.0.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.azpos.app",
    "productName": "AZ POS",
    "copyright": "Copyright © AZ POS",
    "directories": {
      "output": "release"
    },
    "artifactName": "AZ-POS-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/vendor/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/vendor/adb-win",
        "to": "adb",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AZ POS",
      "artifactName": "AZ-POS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AZ-POS-Portable-${version}.${ext}"
    }
  }
}
